          "gcode": "\nM117 Loading Filament...\nG92 E0.0\nG91\nG1 E50 F400\nG1 E25 F100\nG90\nG92 E0.0\nM400\nM117 Load Complete\nUPDATE_DELAYED_GCODE ID=clear_display DURATION=5",
          "description": "G-Code macro"
        },
        "gcode_macro unload_filament": {
          "gcode": "\nM117 Unloading Filament...\nG92 E0.0\nG91\nG1 E-32 F5200\nG1 E-10 F100\nG1 E-38 F1000\nG90\nG92 E0.0\nM400\nM300 S300 P1000\nM117 Remove Filament Now!\nUPDATE_DELAYED_GCODE ID=clear_display DURATION=5",
          "description": "G-Code macro"
        },
        "gcode_macro g80": {
          "gcode": "\nG28\nBED_MESH_CALIBRATE\nG1 X0 Y0 F4000",
          "description": "G-Code macro"
        },
        "gcode_macro g81": {
          "gcode": "\n{% set S = params.S|default(0) %}\nBED_MESH_OUTPUT CENTER_ZERO={S}",
          "description": "G-Code macro"
        },
        "gcode_macro m300": {
          "gcode": "\n{% set S = params.S|default(1000) %}\n{% set P = params.P|default(100) %}\nSET_PIN PIN=BEEPER_pin VALUE={S}\nG4 P{P}\nSET_PIN PIN=BEEPER_pin VALUE=0",
          "description": "G-Code macro"
        },
        "gcode_macro print_start": {
          "gcode": "\n{% set MATERIAL = params.MATERIAL|default(\"Unknown\") %}\n{% set LAYER_HEIGHT = params.LAYER_HEIGHT|default(0) %}\nM83\nCLEAR_PAUSE\nSET_IDLE_TIMEOUT TIMEOUT=600\nSET_PRESSURE_ADVANCE ADVANCE=0\nSET_GCODE_OFFSET Z=0\nG90\nM104 S170\nM190 S{params.BTMP}\nM109 S170\nG80\nM104 S{params.ETMP}\nG1 X1 Y-3.0 Z20 F1000.0\nM109 S{params.ETMP}\nG1 Z.4\nG92 E0.0\nG91\nG1 X60.0 E9.0  F1000.0\nG1 X40.0 E12.5  F1000.0\nG90\nG92 E0.0\n{% if MATERIAL != \"PLA\" %}\nSET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY=1\n{% endif %}\n{% if LAYER_HEIGHT|float < 0.051 %}\nM221 S100\n{% else %}\nM221 S95\n{% endif %}",
          "description": "G-Code macro"
        },
        "gcode_macro print_end": {
          "gcode": "\nCLEAR_PAUSE\nM400\nBED_MESH_CLEAR\nG92 E0.0\nG91\n{% if printer.gcode_move.gcode_position.x > 20 %}\n{% if printer.gcode_move.gcode_position.y > 20 %}\nG1 Z+1.00 X-20.0 Y-20.0 F20000\n{% else %}\nG1 Z+1.00 X-20.0 F20000\n{% endif %}\n{% elif printer.gcode_move.gcode_position.y > 20 %}\nG1 Z+1.00 Y-20.0 F20000\n{% endif %}\nG1 E-8.00 F500\nG90\n{% if printer.gcode_move.gcode_position.z < 100 %}\nG0 Z100 F1500\n{% elif printer.gcode_move.gcode_position.z < 190 %}\nG91\nG0 Z10 F1500\nG90\n{% endif %}\nG0 X10 Y200 F6000\nSET_GCODE_OFFSET Z=0 MOVE=1\nTURN_OFF_HEATERS\nSET_VELOCITY_LIMIT VELOCITY=300 SQUARE_CORNER_VELOCITY=5\nM84\nM107\nM204 S3000\nM221 S100",
          "description": "G-Code macro"
        },
        "gcode_macro cancel_print": {
          "gcode": "\nPAUSE\nSDCARD_RESET_FILE\nPRINT_END\nCLEAR_PAUSE",
          "rename_existing": "BASE_CANCEL_PRINT",
          "description": "G-Code macro"
        },
        "gcode_macro test_remote_method": {
          "gcode": "\n{action_call_remote_method(method=\"moonraker_test\",\nresult=\"test\")}",
          "description": "G-Code macro"
        },
